{
  "name": "dsh-crew",
  "version": "0.1.3",
  "type": "module",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "description": "DeepSeek Harness (dsh) plugin: run work as a small crew of role agents (product manager, engineer, code reviewer) that talk through files on disk, with the PM as the only voice to the user.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "deepseek",
    "cordis",
    "ai",
    "llm",
    "ai-agent",
    "agents",
    "multi-agent",
    "agent-team",
    "subagent",
    "orchestration",
    "agent-orchestration",
    "coding-agent",
    "code-review",
    "code-reviewer",
    "product-manager",
    "prd",
    "software-team",
    "developer-tools",
    "cli"
  ],
  "license": "MIT",
  "author": "Stuart Hu",
  "homepage": "https://github.com/stuarthu/dsh-crew#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stuarthu/dsh-crew.git"
  },
  "bugs": {
    "url": "https://github.com/stuarthu/dsh-crew/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node tools/verify-guard.mjs && node tools/verify-mount.mjs"
  },
  "exports": {
    "./host/crew.js": "./host/crew.js",
    "./host/git-guard.js": "./host/git-guard.js",
    "./package.json": "./package.json"
  },
  "files": [
    "host",
    "roles",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-tool-subagent": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tool-subagent": {
      "optional": false
    }
  }
}
